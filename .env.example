# Copie este archivo como .env para desarrollo local. NUNCA suba .env al repositorio.
DEBUG=true
SECRET_KEY=cambie-esto
# PostgreSQL (Neon en producción). Sin DATABASE_URL se usa SQLite local.
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambie-esto
